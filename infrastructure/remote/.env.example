# COPY THIS TO infrastructure/remote/.env ON THE SERVER; never commit real values.
# Hostname only, no scheme/path. Point its DNS A record at your Linux VPS.
MCP_DOMAIN=stocks.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=
# The mcp_ro role must already exist; URL-encode special password characters.
# Keep the PostgreSQL port bound to loopback. Adjust to your existing DB configuration.
MCP_RO_DATABASE_URL=postgresql://mcp_ro:REPLACE_ME@127.0.0.1:55432/vnmcp
